SUPABASE_URL=  # Supabase project URL
SUPABASE_ANON_KEY=  # public anon key
SUPABASE_SERVICE_ROLE_KEY=  # routing service only; never in frontend code
NWS_USER_AGENT=  # required by api.weather.gov
XAI_API_KEY=  # optional
XAI_MODEL=  # optional; required alongside XAI_API_KEY for POST /preferences/parse, e.g. grok-4.7
GRAPH_PATH=  # default: cornell_data/graph/graph.pkl
